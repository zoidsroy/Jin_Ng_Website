---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localePath, t, type Lang } from '../lib/i18n';

interface Props {
  work: CollectionEntry<'works'>;
  lang: Lang;
  /** The first row is above the fold on most screens — load it eagerly. */
  eager?: boolean;
}

const { work, lang, eager = false } = Astro.props;
const { title, category, year, cover, type } = work.data;

const href = localePath(`/works/${work.id}`, lang);
---

<article class="card" data-type={type}>
  <a class="card__link" href={href}>
    <div class="card__media">
      <Image
        src={cover}
        alt={t(title, lang)}
        widths={[400, 700, 1000]}
        sizes="(min-width: 1200px) 30vw, (min-width: 760px) 45vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>

    <div class="card__body">
      <h3 class="card__title">{t(title, lang)}</h3>
      <p class="card__meta">
        <span>{t(category, lang)}</span>
        <span class="card__year">{year}</span>
      </p>
    </div>
  </a>
</article>

<style>
  .card {
    /* Filtering fades cards out rather than snapping the grid. */
    transition: opacity 0.3s var(--ease);
  }

  .card[hidden] {
    display: none;
  }

  .card__link {
    display: block;
  }

  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s var(--ease),
      opacity 0.4s var(--ease);
  }

  .card__link:hover .card__media :global(img) {
    transform: scale(1.045);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1rem;
  }

  .card__title {
    font-size: var(--step-1);
    font-weight: 600;
    transition: color 0.25s var(--ease);
  }

  .card__link:hover .card__title {
    color: var(--accent);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  .card__year {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
