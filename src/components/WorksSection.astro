---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';
import { useTranslations, type UiKey } from '../data/ui';
import type { Lang } from '../lib/i18n';

interface Props {
  works: CollectionEntry<'works'>[];
  lang: Lang;
}

const { works, lang } = Astro.props;
const ui = useTranslations(lang);

// Only offer a filter for types that actually have works behind them.
const presentTypes = [...new Set(works.map((work) => work.data.type))];
const filters = [
  { value: 'all', label: ui('works.all') },
  ...presentTypes.map((type) => ({
    value: type,
    label: ui(`type.${type}` as UiKey),
  })),
];
---

<section class="section works" id="works">
  <div class="shell">
    <div class="section__head works__head">
      <h2 class="section__title">{ui('works.title')}</h2>
      <span class="label works__count">{String(works.length).padStart(2, '0')}</span>
    </div>

    {
      filters.length > 2 && (
        <div class="works__filters" role="group" aria-label={ui('works.filterLabel')}>
          {filters.map((filter) => (
            <button
              type="button"
              class="works__filter"
              data-filter={filter.value}
              aria-pressed={filter.value === 'all' ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))}
        </div>
      )
    }

    <div class="works__grid" data-works-grid>
      {
        works.map((work, index) => (
          <WorkCard work={work} lang={lang} eager={index < 3} />
        ))
      }
    </div>

    <p class="works__empty" hidden>{ui('works.empty')}</p>
  </div>
</section>

<style>
  .works__head {
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .works__count {
    font-variant-numeric: tabular-nums;
  }

  .works__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .works__filter {
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .works__filter:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .works__filter[aria-pressed='true'] {
    color: var(--fg);
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .works__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: clamp(1.75rem, 3.5vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  .works__empty {
    margin-top: 2rem;
    color: var(--fg-faint);
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-works-grid]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.works__filter');
  const empty = document.querySelector<HTMLElement>('.works__empty');

  if (grid && buttons.length) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];

    const apply = (value: string) => {
      let shown = 0;

      for (const card of cards) {
        const match = value === 'all' || card.dataset.type === value;
        card.hidden = !match;
        if (match) shown += 1;
      }

      if (empty) empty.hidden = shown > 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        apply(button.dataset.filter ?? 'all');
      });
    }
  }
</script>
