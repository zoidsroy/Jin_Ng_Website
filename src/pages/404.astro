---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../data/ui';
import { profile } from '../data/site';
import { t } from '../lib/i18n';

// GitHub Pages serves a single 404.html for every missing path, including
// Chinese ones, so this page shows both languages rather than guessing.
const en = useTranslations('en');
const zh = useTranslations('zh');
---

<Base lang="en" title={`${en('404.title')} — ${t(profile.name, 'en')}`} langHref="/zh">
  <section class="notfound shell">
    <p class="label">404</p>

    <h1>{en('404.title')}</h1>
    <p class="notfound__body">{en('404.body')}</p>
    <a class="link" href="/">{en('404.home')} →</a>

    <hr />

    <h2 lang="zh-Hant-TW">{zh('404.title')}</h2>
    <p class="notfound__body" lang="zh-Hant-TW">{zh('404.body')}</p>
    <a class="link" href="/zh" lang="zh-Hant-TW">{zh('404.home')} →</a>
  </section>
</Base>

<style>
  .notfound {
    min-height: 70svh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.75rem;
    padding-block: 10rem 6rem;
  }

  .notfound h1,
  .notfound h2 {
    font-size: var(--step-3);
  }

  .notfound__body {
    color: var(--fg-dim);
    margin: 0;
  }

  .notfound hr {
    width: 4rem;
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--line-strong);
  }
</style>
